{
  "name": "dsh-netmon",
  "version": "1.0.0",
  "description": "DeepSeek Harness plugin: a header chip + panel showing bridge health, LAN entry, tunnel reachability and device summary.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "network",
    "monitor",
    "tunnel"
  ],
  "license": "MIT",
  "author": "cuteG41cute",
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
